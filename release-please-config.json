{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "changelog-sections": [
    {"type": "feat", "section": "New"},
    {"type": "fix", "section": "Fixes"},
    {"type": "perf", "section": "Faster"},
    {"type": "revert", "section": "Reverted"}
  ],
  "packages": {
    ".": {
      "package-name": "ramus",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": [".github", "docs"],
      "extra-files": [
        {"type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version"},
        {"type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'ramus' || @.name.value == 'git-core')].version"}
      ]
    }
  }
}
